# Copy to backend/.env only on a new installation; never overwrite an existing private configuration.
# Generate a random persistent value before creating accounts.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
CORS_ORIGINS=["http://127.0.0.1:5173"]

# OpenAI-compatible provider; server-side only.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional interview-only model on the SAME provider/key. Empty inherits LLM_MODEL.
# Use a provider-supported model you have benchmarked; this does not guarantee latency.
INTERVIEW_LLM_MODEL=
INTERVIEW_MAX_TOKENS=1000
INTERVIEW_TEMPERATURE=0.2
# Tokens: 512..2400; temperature: 0..1. Restart backend after changes.

ACCESS_TOKEN_MINUTES=15
QUOTA_LLM_TOKENS=200000

# Optional cloud interview voice; without a key use browser speech or text.
# Never read credentials from an external script.
MAMBO_TTS_API=https://api.milorapart.top/apis/mbAIscvip
MAMBO_TTS_KEY=
