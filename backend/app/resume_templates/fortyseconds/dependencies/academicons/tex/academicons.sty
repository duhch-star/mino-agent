\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{academicons}[2026/09/09 v1.9.6-3 Academicons Icons]

\RequirePackage{iftex}

\def\ai@family{academicons}

% pdfTeX
\ifPDFTeX
  % \RequirePackage[T1]{fontenc}
  % \newcommand\ai{\usefont{U}{\ai@family}{m}{n}}
  % \DeclareRobustCommand\ai@icon[1]{{\fontfamily{\ai@family}\selectfont#1}}

  % \DeclareRobustCommand\ai@icon{\fontencoding{U}\fontfamily{\ai@family}\selectfont}
  \DeclareRobustCommand\ai@icon{\usefont{U}{\ai@family}{m}{n}\selectfont}

  \input{academicons-pdftex.tex}

% XeTeX/LuaTeX
\else
  \RequirePackage{fontspec}

  % Name the font file, not the font family. Without Extension, fontspec does
  % not look for a file and falls through to a system lookup by name; since the
  % Type 1 font shipped for pdfTeX also registers as `Academicons', that lookup
  % can return it, and it carries no Unicode cmap -- so every icon resolves to a
  % missing glyph, silently.
  \newfontfamily\ai@font{\ai@family}[
    Extension = .otf,
    UprightFont = *,
    BoldFont = *,
    ItalicFont = *,
    BoldItalicFont = *
  ]

  % \newcommand\ai@unicodefont{\usefont{TU}{\ai@family}{m}{n}}
  % \renewcommand*{\aiicon}[1]{\ai@font\csname aiicon@#1\endcsname}

  \DeclareRobustCommand\ai@icon[1]{\ai@font#1}

  \input{academicons-xeluatex.tex}
\fi

% user commands
\newcommand*{\aiicon}[1]{\ai@icon{\csname aiicon@#1\endcsname}}
% \newcommand*{\aiicon}[1]{\csname aiicon@#1\endcsname}
\input{academicons-generic.tex}

\endinput
